<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Manage Rooms</title>
</head>
<body>
  <%- include('partials/header', { user: user, message: message }) %>
  <div class="container mt-4">
    <h1 class="mb-4">Manage Rooms</h1>
    <% if (rooms && rooms.length > 0) { %>
      <div class="table-responsive">
        <table class="table table-bordered table-striped">
          <thead class="thead-dark">
            <tr>
              <th>Room Name</th>
              <th>Room Capacity</th>
              <th>Availability Start</th>
              <th>Availability End</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% rooms.forEach(room => { %>
              <tr>
                <td><%= room.room_name %></td>
                <td><%= room.room_capacity %></td>
                <td><%= room.availability_start %></td>
                <td><%= room.availability_end %></td>
                <td>
                  <form
                    action="/admin/rooms/<%= room.room_id %>?_method=DELETE"
                    method="POST"
                    style="display: inline">
                    <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <p>No rooms available.</p>
    <% } %>
    <hr/>
    <h2>Add a New Room</h2>
    <form action="/admin/rooms" method="POST" class="border p-4 rounded shadow-sm">
      <div class="form-group">
        <label for="room_name">Room Name:</label>
        <input type="text" class="form-control" id="room_name" name="room_name" required />
      </div>
      <div class="form-group">
        <label for="room_capacity" class="mt-3">Room Capacity:</label>
        <input type="number" class="form-control" id="room_capacity" name="room_capacity" required />
      </div>
      <div class="form-group">
        <label for="availability_start" class="mt-3">Availability Start:</label>
        <input type="time" class="form-control" id="availability_start" name="availability_start" />
      </div>
      <div class="form-group">
        <label for="availability_end" class="mt-3">Availability End:</label>
        <input type="time" class="form-control" id="availability_end" name="availability_end" />
      </div>
      <button type="submit" class="btn btn-primary mt-3">Add Room</button>
    </form>
  </div>
</body>
</html>
