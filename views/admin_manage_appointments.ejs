<%- include('partials/header', { user: user, message: message }) %>
<h2 class="my-4">Manage appointments</h2>
<div class="container">
  <table class="table table-striped table-bordered table-hover">
    <thead>
      <tr>
        <th>Appointment ID</th>
        <th>Username</th>
        <th>Description</th>
        <th>Date</th>
        <th>Status</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% appointments.forEach(function(appointment) { %>
      <tr>
        <td><%= appointment.appointment_id %></td>
        <td><%= appointment.username %></td>
        <td><%= appointment.description %></td>
        <td><%= appointment.appointment_date %></td>
        <td><%= appointment.status %></td>
        <td>
            <% if (appointment.status !== 'accepted') { %>
              <form
              action="/admin/appointments/<%= appointment.appointment_id %>/accepted?_method=PATCH"
              method="POST">
              <button
              type="submit"
              name="status"
              value="accepted"
              class="btn btn-success btn-sm"
              >
                Accept
              </button>
            </form>
            <% } %> 
            <form
            action="/appointments/<%= appointment.appointment_id %>?_method=PATCH"
            method="POST">
            <button
              type="submit"
              name="status"
              value="cancelled"
              class="btn btn-danger btn-sm ml-2"
            >
              Cancel
            </button>
          </form>
        </td>
      </tr>
      <% }); %>
    </tbody>
  </table>
</div>
<h2 class="my-4">Manage reservations</h2>
<div class="container">
  <table class="table table-striped table-bordered table-hover">
    <thead>
      <tr>
        <th>reservation ID</th>
        <th>Username</th>
        <th>Description</th>
        <th>Date</th>
        <th>Status</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% reservations.forEach(function(reservation) { %>
      <tr>
        <td><%= reservation.reservation_id %></td>
        <td><%= reservation.username %></td>
        <td><%= reservation.description %></td>
        <td><%= reservation.reservation_date %></td>
        <td><%= reservation.status %></td>
        <td>
            <% if (reservation.status !== 'accepted') { %>
              <form
              action="/admin/reservations/<%= reservation.reservation_id %>/accepted?_method=PATCH"
              method="POST">
            <button
              type="submit"
              name="status"
              value="completed"
              class="btn btn-success btn-sm"
            >
              Accept
            </button>
            </form>
            <% } %> 
            <form
            action="/reservations/<%= reservation.reservation_id %>?_method=PATCH"
            method="POST">
            <button
              type="submit"
              name="status"
              value="cancelled"
              class="btn btn-danger btn-sm ml-2"
            >
              Cancel
            </button>
            </form>
        </td>
      </tr>
      <% }); %>
    </tbody>
  </table>
</div>
