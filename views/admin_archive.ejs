<%- include('partials/header', { user: user, message: message }) %>
<link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-ENjdO4Dr2bkBIFxQpeoQF/6nZkMV6KA5F7rLTQ5o5N0c5D5jE4q7kRZH6V5KK65"
      crossorigin="anonymous"
    />
<h2>Archived Items</h2>
<br>
<h3>Cancelled Appointments</h3>
<table class="table table-striped mt-4">
  <thead>
    <tr>
      <th>Appointment ID</th>
      <th>Username</th>
      <th>Doctor Name</th>
      <th>Description</th>
      <th>Date & Time</th>
      <th>Status</th>
    </tr>
  </thead>
  <tbody>
    <% if (appointments.length > 0) { %>
      <% appointments.forEach(function(appointment) { %>
        <tr>
          <td><%= appointment.appointment_id %></td>
          <td><%= appointment.username %></td>
          <td><%= appointment.name %></td>
          <td><%= appointment.description %></td>
          <td><%= new Date(appointment.appointment_date).toLocaleString() %></td>
          <td><%= appointment.status %></td>
        </tr>
      <% }); %>
    <% } else { %>
      <tr>
        <td colspan="5">No archived appointments found.</td>
      </tr>
    <% } %>
  </tbody>
</table>
<br>
<h3 class="mt-2">Cancelled Reservations</h3>
<table class="table table-striped mt-4">
  <thead>
    <tr>
      <th>Reservation ID</th>
      <th>Username</th>
      <th>Room Name</th>
      <th>Description</th>
      <th>Date & Time</th>
      <th>Status</th>
    </tr>
  </thead>
  <tbody>
    <% if (reservations.length > 0) { %>
      <% reservations.forEach(function(reservation) { %>
        <tr>
          <td><%= reservation.reservation_id %></td>
          <td><%= reservation.username %></td>
          <td><%= reservation.room_name %></td>
          <td><%= reservation.description %></td>
          <td><%= new Date(reservation.reservation_date).toLocaleString() %></td>
          <td><%= reservation.status %></td>
        </tr>
      <% }); %>
    <% } else { %>
      <tr>
        <td colspan="5">No archived reservations found.</td>
      </tr>
    <% } %>
  </tbody>
</table>