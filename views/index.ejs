  <title>Home | M&C</title>
  <link href="//fonts.googleapis.com/css?family=Open+Sans:400,300,600&amp;subset=cyrillic,latin" rel="stylesheet">
  <link href="path/to/your/icons.css" rel="stylesheet">
  <style>
    body {
      font-family: 'Open Sans', sans-serif;
    }
    .welcome-section {
      padding: 40px 0;
      background-color: #f9f9f9;
    }
    .welcome-section h2 {
      font-size: 28px;
      color: #333;
    }
    .welcome-section p {
      font-size: 16px;
      line-height: 1.6;
      color: #555;
    }
    .specialities-section {
      padding: 50px 0;
      background-color: #fff;
    }
    .headline-center {
      text-align: center;
      margin-bottom: 30px;
    }
    .headline-center h2 {
      font-size: 32px;
      color: #333;
    }
    .headline-center .line {
      width: 100px;
      height: 3px;
      margin: 15px auto;
      background-color: #72c02c;
    }
    .content-box {
      border: 1px solid #ddd;
      border-radius: 8px;
      padding: 20px;
      text-align: center;
      background-color: #f8f8f8;
      transition: transform 0.3s, box-shadow 0.3s;
    }
    .content-box:hover {
      transform: translateY(-5px);
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    }
    .content-box h3 {
      font-size: 18px;
      color: #333;
      margin-top: 15px;
    }
    .content-box p {
      font-size: 14px;
      color: #666;
    }
    .img-circle {
      border-radius: 50%;
      margin-bottom: 20px;
    }
